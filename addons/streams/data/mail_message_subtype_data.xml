<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Внешняя переписка: письма клиентам и от клиентов. Не internal —
             такое сообщение видно приглашённому в канал контрагенту. -->
        <record id="mt_message" model="mail.message.subtype">
            <field name="name">Message</field>
            <field name="description">External correspondence</field>
            <field name="internal" eval="False"/>
            <field name="default" eval="False"/>
            <field name="sequence">5</field>
        </record>

        <!-- Изменения трекаемых полей. default=False, поэтому подписчики на
             него не подписываются и рассылки по нему не происходит. -->
        <record id="mt_change" model="mail.message.subtype">
            <field name="name">Change</field>
            <field name="description">Tracked field change</field>
            <field name="internal" eval="True"/>
            <field name="default" eval="False"/>
            <field name="hidden" eval="True"/>
            <field name="sequence">90</field>
        </record>

        <!-- Синтетические события mail.activity. -->
        <record id="mt_activity" model="mail.message.subtype">
            <field name="name">Activity</field>
            <field name="description">Activity event</field>
            <field name="internal" eval="True"/>
            <field name="default" eval="False"/>
            <field name="hidden" eval="True"/>
            <field name="sequence">91</field>
        </record>

    </data>
</odoo>
