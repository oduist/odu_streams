<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Приглашение (§9.2). Модель рендера — сам участник: письмо не
            должно ни создавать mail.message, ни зависеть от followers (Р11).
            Ссылка берётся из вычисляемого link_url текущего токена.
        -->
        <record id="mail_template_guest_invite" model="mail.template">
            <field name="name">Streams: guest chat invitation</field>
            <field name="model_id" ref="streams.model_mail_channel_external_participant"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="subject">Invitation to the chat about {{ object.channel_id.name }}</field>
            <field name="body_html" type="html">
                <div style="margin:0px;padding:0px;font-size:13px;">
                    <p>Hello <t t-out="object.partner_id.name or ''"/>,</p>
                    <p>
                        you have been invited to the chat about
                        <t t-out="object.channel_id.name or ''"/>.
                    </p>
                    <p>
                        <a t-att-href="object.link_url"
                           style="background-color:#875A7B;padding:8px 16px;text-decoration:none;color:#fff;border-radius:5px;">
                            Open the chat
                        </a>
                    </p>
                    <p>
                        This link is personal and works only once, please do not
                        share it. You can also simply reply to this email.
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!--
            Часовой дайджест (§9.6). Содержимого переписки в письме нет
            намеренно: только факт наличия новых сообщений и ссылка.
        -->
        <record id="mail_template_guest_digest" model="mail.template">
            <field name="name">Streams: guest chat digest</field>
            <field name="model_id" ref="streams.model_mail_channel_external_participant"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="subject">New messages in the chat about {{ object.channel_id.name }}</field>
            <field name="body_html" type="html">
                <div style="margin:0px;padding:0px;font-size:13px;">
                    <p>Hello <t t-out="object.partner_id.name or ''"/>,</p>
                    <p>
                        there are new messages in the chat about
                        <t t-out="object.channel_id.name or ''"/>.
                    </p>
                    <p>
                        <a t-att-href="object.link_url"
                           style="background-color:#875A7B;padding:8px 16px;text-decoration:none;color:#fff;border-radius:5px;">
                            Open the chat
                        </a>
                    </p>
                    <p>
                        This link is personal, please do not share it. You can
                        also simply reply to this email.
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="False"/>
        </record>

        <!--
            Крон дайджеста (§9.6, А7). forcecreate, чтобы запись появилась и
            на уже установленном модуле; интервал правится в настройках.
        -->
        <record id="ir_cron_streams_guest_digest" model="ir.cron" forcecreate="True">
            <field name="name">Streams: guest chat digest</field>
            <field name="model_id" ref="streams.model_mail_channel_external_participant"/>
            <field name="state">code</field>
            <field name="code">model._cron_streams_guest_digest()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
