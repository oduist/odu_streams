<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <data noupdate="1">
        <!--
            Значения по умолчанию (§14). Ключ OpenAI здесь не создаётся: он
            уже живёт в базе как `openai_api_key` (velesagro_crm), и пустой
            seed затёр бы настроенный секрет.
        -->
        <record id="streams_notify_timeout_param" model="ir.config_parameter">
            <field name="key">streams.notify_timeout</field>
            <field name="value">10</field>
        </record>
        <record id="streams_transcription_model_param" model="ir.config_parameter">
            <field name="key">streams.transcription_model</field>
            <field name="value">whisper-1</field>
        </record>

        <!-- Ретраи транскрипции: сеть и лимиты OpenAI отпускают не сразу. -->
        <record id="queue_job_function_streams_notify_transcribe"
                model="queue.job.function">
            <field name="model_id" ref="model_mail_notify"/>
            <field name="method">_job_transcribe</field>
            <field name="edit_retry_pattern">{1: 60, 3: 300, 5: 1800}</field>
        </record>
    </data>

    <!--
        Страховка на случай выключенного jobrunner: в Oduflow-средах
        `queue_job` не всегда поднят server-wide, и задание висит в pending.
    -->
    <record id="ir_cron_streams_notify_transcribe" model="ir.cron">
        <field name="name">Streams: retry stuck voice transcriptions</field>
        <field name="model_id" ref="model_mail_notify"/>
        <field name="user_id" ref="base.user_root"/>
        <field name="state">code</field>
        <field name="code">model._streams_cron_transcribe()</field>
        <!-- numbercall/doall в 19 удалены: крон бессрочный по определению -->
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>
