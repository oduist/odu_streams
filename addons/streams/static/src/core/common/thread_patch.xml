<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<!--
    Ссылка на запись под приветствием канала записи (§11.2).

    Якорь — `t-esc="startMessageSubtitle"`, а не класс: у абзаца с фразой
    «This is the start of the #… channel» классы чисто оформительские
    (`text-muted mb-0 small text-break`) и в соседнем узле шаблона
    повторяются, а геттер — уникален и является контрактом компонента
    (`mail/static/src/core/common/thread.js`).

    Само условие показа — в `streamsRecordLinkLabel` (`thread_patch.js`):
    у обычных каналов и групповых чатов ссылки нет.
-->
<t t-inherit="mail.Thread.startMessage" t-inherit-mode="extension">
    <xpath expr="//p[@t-esc='startMessageSubtitle']" position="after">
        <a t-if="streamsRecordLinkLabel" class="o-streams-Thread-recordLink small" href="#"
           role="button" t-on-click.prevent="() => this.streamsOpenRecord()">
            <i class="fa fa-external-link me-1" role="presentation"/>
            <t t-esc="streamsRecordLinkLabel"/>
        </a>
    </xpath>
</t>

</templates>
