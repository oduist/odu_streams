<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="streams.NotifyPopup">
        <div class="o-streams-NotifyPopup" t-att-class="{ 'o-sticky': popup.is_sticky }"
            t-att-data-notify-id="popup.id"
            t-on-mouseenter="() => this.onMouseEnter(popup)"
            t-on-mouseleave="() => this.onMouseLeave(popup)">
            <StreamsNotifyCard notify="popup">
                <t t-set-slot="header-end">
                    <button class="btn btn-sm btn-link o-streams-NotifyPopup-close p-0 px-1"
                        type="button" aria-label="Close"
                        t-on-click="() => this.onClickClose(popup)">&#215;</button>
                </t>
                <div class="o-streams-NotifyPopup-actions">
                    <button class="btn btn-sm btn-link o-streams-NotifyPopup-reply px-0"
                        type="button" t-on-click="() => this.onClickReply(popup)">Reply</button>
                </div>
            </StreamsNotifyCard>
        </div>
    </t>

    <t t-name="streams.NotifyContainer">
        <div class="o-streams-NotifyContainer">
            <t t-foreach="transientPopups" t-as="popup" t-key="popup.id">
                <t t-call="streams.NotifyPopup"/>
            </t>
            <div t-if="currentSticky" class="o-streams-NotifyContainer-stickyStack">
                <t t-set="popup" t-value="currentSticky"/>
                <t t-call="streams.NotifyPopup"/>
                <div t-if="stickyPopups.length > 1"
                    class="o-streams-NotifyContainer-paginator d-flex align-items-center justify-content-center">
                    <button class="btn btn-sm btn-link" type="button" aria-label="Previous"
                        t-on-click="onClickPrevious">&#8249;</button>
                    <small class="o-streams-NotifyContainer-pagerValue text-muted">
                        <t t-esc="stickyPosition"/> / <t t-esc="stickyPopups.length"/>
                    </small>
                    <button class="btn btn-sm btn-link" type="button" aria-label="Next"
                        t-on-click="onClickNext">&#8250;</button>
                </div>
            </div>
        </div>
    </t>

</templates>
