<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Раскладка кнопок чаттера (§11.1): Comment / Note / Send Message.
        Классы ядровых кнопок сохраняются: на них xpath-ом опираются
        velesagro_crm и email_document со своими кнопками Send Email.
    -->
    <t t-inherit="mail.ChatterTopbar" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_ChatterTopbar_buttonSendMessage')]" position="replace">
            <button class="btn btn-link o_ChatterTopbar_button o_ChatterTopbar_buttonSendMessage"
                type="button"
                t-att-class="{
                    'o-active': chatter.composerView and !chatter.composerView.composer.isLog,
                    'o-bordered': chatter.hasExternalBorder,
                }"
                t-att-disabled="chatter.isDisabled"
                title="Post an internal comment"
                data-hotkey="m"
                t-on-click="chatter.onClickSendMessage"
            >
                Comment
            </button>
        </xpath>
        <xpath expr="//button[hasclass('o_ChatterTopbar_buttonLogNote')]" position="replace">
            <button class="btn btn-link o_ChatterTopbar_button o_ChatterTopbar_buttonLogNote"
                type="button"
                t-att-class="{
                    'o-active': chatter.composerView and chatter.composerView.composer.isLog,
                    'o-bordered': chatter.hasExternalBorder,
                }"
                t-att-disabled="chatter.isDisabled"
                t-on-click="chatter.onClickLogNote"
                title="Log an internal note"
                data-hotkey="shift+m"
            >
                Note
            </button>
        </xpath>
        <xpath expr="//button[hasclass('o_ChatterTopbar_buttonLogNote')]" position="after">
            <button t-if="chatter.thread and chatter.thread.id"
                class="btn btn-link o_ChatterTopbar_button o_ChatterTopbar_buttonStreamsSendMessage"
                type="button"
                t-att-class="{ 'o-bordered': chatter.hasExternalBorder }"
                t-att-disabled="chatter.isDisabled"
                t-on-click="chatter.onClickStreamsSendMessage"
                title="Send an external message to customers"
            >
                Send Message
            </button>
        </xpath>
        <!--
            Notify (§11.1, §12.2): приоритетное уведомление со ссылкой на
            запись. В чаттер и канал записи рекордер голоса не выносится —
            он живёт только в самой форме уведомления.
        -->
        <xpath expr="//button[hasclass('o_ChatterTopbar_buttonStreamsSendMessage')]" position="after">
            <button t-if="chatter.thread and chatter.thread.id"
                class="btn btn-link o_ChatterTopbar_button o_ChatterTopbar_buttonStreamsNotify"
                type="button"
                t-att-class="{ 'o-bordered': chatter.hasExternalBorder }"
                t-att-disabled="chatter.isDisabled"
                t-on-click="chatter.onClickStreamsNotify"
                title="Send a priority notification about this record"
            >
                Notify
            </button>
        </xpath>
        <!--
            Changes (§11.1): диалог подписки на поля записи. Доступен и тем,
            кто не участвует в канале записи — подписка от участия не зависит.
        -->
        <xpath expr="//button[hasclass('o_ChatterTopbar_buttonStreamsNotify')]" position="after">
            <button t-if="chatter.thread and chatter.thread.id"
                class="btn btn-link o_ChatterTopbar_button o_ChatterTopbar_buttonStreamsChanges"
                type="button"
                t-att-class="{ 'o-bordered': chatter.hasExternalBorder }"
                t-att-disabled="chatter.isDisabled"
                t-on-click="chatter.onClickStreamsChanges"
                title="Choose which field changes reach your Changes stream"
            >
                Changes
            </button>
        </xpath>
        <!--
            Invite customer (§9.2, решение 2 от 2026-08-18): кнопка есть и на
            записях без канала — приглашение канал создаёт (пятый триггер
            §5.1), поэтому чаттеру не нужно знать, есть ли канал.
        -->
        <xpath expr="//button[hasclass('o_ChatterTopbar_buttonStreamsChanges')]" position="after">
            <button t-if="chatter.thread and chatter.thread.id"
                class="btn btn-link o_ChatterTopbar_button o_ChatterTopbar_buttonStreamsInvite"
                type="button"
                t-att-class="{ 'o-bordered': chatter.hasExternalBorder }"
                t-att-disabled="chatter.isDisabled"
                t-on-click="chatter.onClickStreamsInvite"
                title="Give a customer access to this chat by a personal link"
            >
                Invite customer
            </button>
        </xpath>
    </t>

</templates>
