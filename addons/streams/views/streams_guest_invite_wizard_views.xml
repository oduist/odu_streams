<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="streams_guest_invite_wizard_form" model="ir.ui.view">
        <field name="name">streams.guest.invite.wizard.form</field>
        <field name="model">streams.guest.invite.wizard</field>
        <field name="arch" type="xml">
            <form string="Invite a customer to this chat">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="channel_id" invisible="1"/>
                <field name="state" invisible="1"/>
                <group>
                    <field name="record_name" readonly="1"/>
                </group>
                <div class="alert alert-warning" role="alert"
                     invisible="state == 'done'">
                    The invited contact will see every comment and message in this
                    channel posted after the selected moment, including attachments.
                    Notes, field changes and activities stay private.
                </div>
                <group invisible="state == 'done'">
                    <field name="partner_ids" widget="many2many_tags"
                        options="{'no_quick_create': True}"
                        placeholder="Pick the contacts to invite"/>
                    <field name="history_from"/>
                    <field name="send_email"/>
                </group>
                <div invisible="state != 'done'">
                    <h3>Personal links</h3>
                    <p class="text-muted">
                        Copy the link and send it to the contact if they have no email.
                        Every link works only once.
                    </p>
                    <field name="link_ids" nolabel="1" readonly="1">
                        <list create="false" delete="false">
                            <field name="partner_id"/>
                            <field name="url" widget="CopyClipboardChar"/>
                            <field name="email_sent"/>
                        </list>
                    </field>
                    <div class="alert alert-warning" role="alert"
                         invisible="not reply_warning">
                        <field name="reply_warning" nolabel="1" readonly="1"/>
                    </div>
                </div>
                <div invisible="not access_ids">
                    <h3>Existing access</h3>
                    <field name="access_ids" nolabel="1">
                        <list create="false" delete="false">
                            <field name="partner_id"/>
                            <field name="invited_on"/>
                            <field name="last_seen"/>
                            <field name="is_link_consumed"/>
                            <field name="participant_id" invisible="1"/>
                            <button name="action_revoke_participant" type="object"
                                string="Revoke" icon="fa-ban" class="text-danger"/>
                        </list>
                    </field>
                </div>
                <footer>
                    <button string="Invite" name="action_invite" type="object"
                        class="btn-primary" data-hotkey="q"
                        invisible="state == 'done'"/>
                    <button string="Cancel" class="btn-secondary"
                        special="cancel" data-hotkey="z"
                        invisible="state == 'done'"/>
                    <button string="Close" class="btn-primary"
                        special="cancel"
                        invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
