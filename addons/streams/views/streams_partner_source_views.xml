<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Реестр источников виртуального чаттера контакта (§18.3).
         Живёт в Settings → Technical → Email: правка реестра
         пересобирает SQL VIEW ленты, это операция администратора. -->
    <record id="streams_partner_source_view_list" model="ir.ui.view">
        <field name="name">streams.partner.source.list</field>
        <field name="model">streams.partner.source</field>
        <field name="arch" type="xml">
            <list string="Partner Feed Sources" editable="bottom">
                <field name="model_id" options="{'no_create': True}"/>
                <field name="field_id" options="{'no_create': True}"/>
                <field name="model_name" optional="hide"/>
                <field name="field_name" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
                <button name="action_preview" type="object" string="Preview"
                        icon="fa-search" title="Count matching messages"/>
            </list>
        </field>
    </record>

    <record id="streams_partner_source_view_form" model="ir.ui.view">
        <field name="name">streams.partner.source.form</field>
        <field name="model">streams.partner.source</field>
        <field name="arch" type="xml">
            <form string="Partner Feed Source">
                <header>
                    <button name="action_preview" type="object"
                            string="Preview" class="btn-secondary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="field_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Messages of the records of this model are shown in the
                        chatter of the partner referenced by this field
                        (Related and Company scopes). The message itself stays
                        on its own record.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="streams_partner_source_action" model="ir.actions.act_window">
        <field name="name">Partner Feed Sources</field>
        <field name="res_model">streams.partner.source</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a model and its partner field
            </p><p>
                Each row adds one branch to the aggregated partner chatter.
            </p>
        </field>
    </record>

    <menuitem id="streams_partner_source_menu"
              name="Partner Feed Sources"
              parent="base.menu_email"
              action="streams_partner_source_action"
              groups="base.group_system"
              sequence="100"/>

</odoo>
