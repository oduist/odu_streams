<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Пользователь видит и отзывает только свои устройства; создание —
         только login-контроллером (sudo). -->
    <record id="streams_mobile_device_own_rule" model="ir.rule">
        <field name="name">streams_mobile: own devices only</field>
        <field name="model_id" ref="model_streams_mobile_device"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
