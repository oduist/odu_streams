<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="streams_mobile_device_view_list" model="ir.ui.view">
        <field name="name">streams.mobile.device.list</field>
        <field name="model">streams.mobile.device</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="user_id"/>
                <field name="name"/>
                <field name="platform"/>
                <field name="app_version"/>
                <field name="push_enabled"/>
                <field name="last_activity"/>
                <button name="action_revoke" type="object" string="Revoke"
                        icon="fa-ban" confirm="Revoke this device token?"/>
            </list>
        </field>
    </record>

    <record id="streams_mobile_device_action" model="ir.actions.act_window">
        <field name="name">Mobile Devices</field>
        <field name="res_model">streams.mobile.device</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="streams_mobile_device_menu"
              name="Streams Mobile Devices"
              parent="base.menu_users"
              action="streams_mobile_device_action"
              groups="base.group_system"
              sequence="50"/>
</odoo>
